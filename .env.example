# ============================================================================
# MuMu Camera 環境設定檔
# ============================================================================
#
# 使用方式：
#   1. 複製此檔案為 .env：cp .env.example .env
#   2. 根據你的環境修改設定值
#   3. 啟動服務：docker-compose up -d
#
# ============================================================================


# ============================================================================
# 資料庫設定 (PostgreSQL)
# ============================================================================
# 資料庫名稱
POSTGRES_DB=mumucam

# 資料庫使用者名稱
POSTGRES_USER=mumucam

# 資料庫密碼
# [部署必改] 請更換為強密碼（建議 20+ 字元，包含大小寫英文、數字、符號）
# 範例：openssl rand -base64 32
POSTGRES_PASSWORD=mumucam123


# ============================================================================
# TURN Server 設定 (coturn)
# ============================================================================
# TURN Server 用於 WebRTC 連線中繼，當 P2P 直連失敗時使用
#
# 運作原理：
#   瀏覽器 ◄──────► TURN Server ◄──────► 攝影機
#              （當 P2P 連不通時，影像透過這裡中繼）
#
# ----------------------------------------------------------------------------

# TURN 內部主機名稱
# Docker 容器之間的內部通訊用，不需要修改
TURN_HOST=coturn

# TURN 公開主機名稱
# [部署必改] 瀏覽器連接 TURN Server 用的地址
#
# 本地開發：localhost
# 正式部署：改為你的公網 IP 或域名
#
# 範例：
#   TURN_PUBLIC_HOST=cam.yourdomain.com    （推薦，使用域名）
#   TURN_PUBLIC_HOST=203.1.2.3             （使用公網 IP）
TURN_PUBLIC_HOST=localhost

# TURN Server 連接埠
# 預設 3478，通常不需要修改
# [部署注意] 防火牆需開放此埠的 TCP 和 UDP
TURN_PORT=3478

# TURN 認證密鑰
# [部署必改] 用於生成 TURN 認證憑證，請更換為隨機字串
# 範例：openssl rand -base64 32
TURN_SECRET=mumucam_turn_secret_key_change_in_production


# ============================================================================
# 後端 API 設定 (Backend)
# ============================================================================

# JWT 密鑰
# [部署必改] 用於簽發使用者登入令牌，請更換為隨機字串
# 範例：openssl rand -base64 64
JWT_SECRET=mumucam_jwt_secret_key_change_in_production

# CORS 允許的來源
# [部署必改] 設定允許存取 API 的網域
#
# 本地開發：http://localhost,http://localhost:8080
# 正式部署：改為你的前端網域
#
# 範例：
#   BACKEND_CORS_ORIGINS=https://cam.yourdomain.com
#   BACKEND_CORS_ORIGINS=https://cam.yourdomain.com,https://www.yourdomain.com
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:8080


# ============================================================================
# Redis 設定
# ============================================================================
# Redis 密碼
# [部署必改] 請更換為強密碼，防止未授權存取
# 範例：openssl rand -base64 32
REDIS_PASSWORD=mumucam_redis_secret

# Redis 連線 URL（使用 Docker 內部網路，通常不需要修改）
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0


# ============================================================================
# Web 服務設定 (Nginx)
# ============================================================================
# Web 前端服務端口
# 如果 8080 被其他服務佔用，可以改成其他端口
# 範例：WEB_PORT=8088
WEB_PORT=8080


# ============================================================================
# 部署檢查清單
# ============================================================================
#
# 部署前請確認以下項目：
#
# 1. 密碼/密鑰 (必須更換)
#    [ ] POSTGRES_PASSWORD - 資料庫密碼
#    [ ] REDIS_PASSWORD    - Redis 密碼
#    [ ] TURN_SECRET       - TURN 認證密鑰
#    [ ] JWT_SECRET        - JWT 簽名密鑰
#
# 2. 網域設定 (必須更換)
#    [ ] TURN_PUBLIC_HOST    - TURN Server 公開地址
#    [ ] BACKEND_CORS_ORIGINS - 允許的前端網域
#
# 3. 防火牆設定 (必須開放)
#    [ ] TCP 80/443        - Web + API（如果用 HTTPS）
#    [ ] TCP 3478          - TURN 信令
#    [ ] UDP 3478          - TURN 信令
#    [ ] UDP 49152-49252   - TURN 媒體中繼（影像串流）
#    [!] 切勿對外開放 5432 (PostgreSQL) 和 6379 (Redis)
#
# 4. DNS 設定
#    [ ] 將域名指向你的伺服器 IP
#
# ============================================================================


# ============================================================================
# 部署範例
# ============================================================================
#
# 假設你的域名是 cam.example.com，伺服器 IP 是 203.1.2.3
#
# --- 正式環境 .env 範例 ---
#
# POSTGRES_DB=mumucam
# POSTGRES_USER=mumucam
# POSTGRES_PASSWORD=aG7#kL9$mN2@pQ5&rT8*
#
# TURN_HOST=coturn
# TURN_PUBLIC_HOST=cam.example.com
# TURN_PORT=3478
# TURN_SECRET=xK4$nM7#bV2@cZ9&fH5*jL8!
#
# JWT_SECRET=yR6#tU9$wX3@zB7&dF2*gJ5!kM8#nP4$qS7@vC9&
# BACKEND_CORS_ORIGINS=https://cam.example.com
#
# REDIS_PASSWORD=hQ3#mK7$nR2@sV9&wX5*
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
#
# ============================================================================


# ============================================================================
# 樹莓派 Device Agent 設定（在樹莓派上設定，非此檔案）
# ============================================================================
#
# 在樹莓派上執行 device-agent 時需要設定以下環境變數：
#
# 必要設定：
#   DEVICE_ID    - 設備唯一識別碼（例如：pi-cam-001）
#   BACKEND_URL  - 後端 WebSocket 地址
#
# 範例：
#   export DEVICE_ID=pi-cam-001
#   export BACKEND_URL=wss://cam.example.com/ws/device
#   python agent.py
#
# 或使用命令列參數：
#   python agent.py --device-id pi-cam-001 --backend wss://cam.example.com/ws/device
#
# 產生配對碼：
#   python pair.py --device-id pi-cam-001 --backend https://cam.example.com
#
# ============================================================================

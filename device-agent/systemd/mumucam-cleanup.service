[Unit]
Description=MuMu Camera 錄影清理服務
After=network.target

[Service]
Type=oneshot
User=mumucam
Group=mumucam
WorkingDirectory=/opt/mumucam/device-agent
EnvironmentFile=/etc/mumucam/agent.env
ExecStart=/opt/mumucam/venv/bin/python /opt/mumucam/device-agent/cleaner.py
StandardOutput=journal
StandardError=journal

# 多目錄清理（cam + cam2 合計管控，57GB 磁碟保留 ~12GB 給系統）
Environment="RECORDING_DIRS=/mnt/usb/recordings/cam,/mnt/usb/recordings/cam2"
Environment="CLEANUP_MAX_GIB=45"
Environment="CLEANUP_TARGET_GIB=38"
Environment="CLEANUP_RETENTION_DAYS=7"

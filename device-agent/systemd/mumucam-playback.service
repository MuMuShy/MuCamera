[Unit]
Description=MuMu Camera 回放 API 服務
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mumucam
Group=mumucam
WorkingDirectory=/opt/mumucam/device-agent
EnvironmentFile=/etc/mumucam/agent.env
ExecStart=/opt/mumucam/venv/bin/python -m uvicorn local_api.server:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# 回放 API 相關環境變數
Environment="RECORDING_DIR=/opt/mumucam/recordings/cam"
Environment="HLS_CACHE_DIR=/tmp/mumucam-hls"
Environment="LOCAL_API_HOST=127.0.0.1"
Environment="LOCAL_API_PORT=8090"

# 優雅關閉
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
